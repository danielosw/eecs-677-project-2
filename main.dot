digraph {
		Node0 [shape=record,label="define i32 @main() \n\n  %aVar = alloca i32\n\n  store i32 0, ptr %aVar\n\n  br label %loop\n"]
		Node1 [shape=record,label="loop:\n\n  %loaded = load i32, ptr %aVar\n\n  call void @SINK(i32 %loaded)\n\n  %cond = icmp eq i32 0, 0\n\n  br i1 %cond, label %body, label %exit\n"]
		Node2 [shape=record,label="body:\n\n  %secret = call i32 (...) @SOURCE()\n\n  store i32 %secret, ptr %aVar\n\n  br label %loop\n"]
		Node3 [shape=record,label="exit:\n\n  ret i32 0\n"]
		Node0 -> Node1 [label=0];
		Node1 -> Node2 [label=0];
		Node1 -> Node3 [label=1];
		Node2 -> Node1 [label=0];
}