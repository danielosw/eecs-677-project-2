digraph {
		Node0 [shape=record,label="define i32 @main() \n\n  %aVar = alloca i32\n\n  %a1 = load i32, ptr %aVar\n\n  %ifTruth = icmp ne i32 %a1, 0\n\n  br i1 %ifTruth, label %ifBody, label %afterIf\n"]
		Node1 [shape=record,label="ifBody:\n\n  %secret = call i32 (...) @SOURCE()\n\n  store i32 %secret, ptr %aVar\n\n  br label %afterIf\n"]
		Node2 [shape=record,label="afterIf:\n\n  %a2 = load i32, ptr %aVar\n\n  call void @SINK(i32 %a2)\n\n  store i32 0, ptr %a2\n\n  ret i32 0\n"]
		Node0 -> Node1 [label=0];
		Node0 -> Node2 [label=1];
		Node1 -> Node2 [label=0];
}