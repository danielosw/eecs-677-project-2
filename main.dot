digraph {
		Node0 [shape=record,label="define i32 @main(i32 %argc) \n\n        %noArgs = icmp eq i32 %argc, 1\n\n        br i1 %noArgs, label %lbl_t, label %lbl_f\n"]
		Node1 [shape=record,label="lbl_t:\n\n        %varT = add i32 1, 0\n\n        br label %end\n"]
		Node2 [shape=record,label="lbl_f:\n\n        %varF = add i32 2, 0\n\n        br label %end\n"]
		Node3 [shape=record,label="end:\n\n        %var = phi i32 [%varT, %lbl_t], [%varF, %lbl_f]\n\n        ret i32 %var\n"]
		Node0 -> Node1 [label=0];
		Node0 -> Node2 [label=1];
		Node1 -> Node3 [label=0];
		Node2 -> Node3 [label=0];
}